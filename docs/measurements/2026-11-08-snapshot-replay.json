{
  "date": "2026-11-08",
  "environment": "Apple M2, 8 cores, 8 GB RAM, macOS arm64. Three voters and an independent POSIX journal on the same machine; mTLS gRPC over loopback. Optimized Rust release binaries. Each trial used fresh directories, ordinary host caches, and 32 closed-loop foreground callers on the embedded protected API.",
  "accounting_scope": "Application measurements for the single successfully installed snapshot in each phase. Earlier interrupted offers, TCP/TLS framing, HTTP/2 and gRPC headers, foreground RPCs and journal I/O are outside these counters. This is a local multi-megabyte fixture.",
  "reproduce": "cargo test --release --locked -p ledger-node --test network snapshot_catchup_under_payment_load -- --ignored --nocapture",
  "series": {
    "baseline": "Unmodified file-transfer binary, stored before the implementation. Measured bytes include actual manifest, fetched files and canonical history. Full protobuf message byte counters were unavailable.",
    "optimized": "File transfer or bounded authenticated replay, selected per offer. Each same-offer comparison uses the actual sender inventory, receiver inventory, and published canonical history. Different timed foreground counts cause later offers to differ between runs."
  },
  "binary_sha256": {
    "baseline": "c328641dc8f217e954201876242ae68ce5cedaaba2066260e3b845e432263589",
    "optimized": "1616942f8b1cc9fde24e20f7bd75de30dd5b0bbdf2a6f47eef4bd2fafcb23b5e"
  },
  "field_definitions": {
    "trial": "One independent fresh cluster, with phases run in the recorded order.",
    "independent_layout": "Observed immediately before the independent receiver went offline. cut_index is a common committed Raft index. receiver_compactions counts RocksDB compaction_finished events. *_sst_count counts SSTs at that cut; common_sst_bytes sums sender table bytes with byte-identical receiver content.",
    "phase": "cold has no earlier receiver checkpoint; shared has a previous peer image; independent has rebuilt and independently compacted its own legitimate copy of the same ledger.",
    "seal_index": "Offered checkpoint's Raft log index.",
    "target_index": "Committed marker in the ordinary replicated tail that the receiver must also apply.",
    "manifest_bytes": "Actual bytes of the sender's checkpoint manifest.",
    "file_bytes": "Actual bytes fetched from the sender's RocksDB files, including private metadata.",
    "reused_file_bytes": "File bytes already present or staged in physical-transfer mode. Replay reports zero.",
    "history_bytes": "Bytes in original encoded Raft entries fetched. Verified against reopened voter in optimized trials.",
    "history_entries": "Number of original encoded Raft entries fetched. One may contain many decisions.",
    "clients": "Number of simultaneous foreground callers.",
    "follower_reopen_ms": "Milliseconds until the returning node's start call returned.",
    "catchup_ms": "Milliseconds from node start returning through installation plus the tail marker.",
    "foreground_calls": "All protected writes started by the foreground callers during catch-up, including late completions.",
    "completed_in_window": "Foreground writes acknowledged before catch-up completed.",
    "catchup_p50_ms": "Per-trial median latency, in milliseconds, across foreground calls.",
    "catchup_p99_ms": "Per-trial nearest-rank p99 latency, in milliseconds, across foreground calls.",
    "baseline_p50_ms": "Median latency in milliseconds for a subsequent foreground control with the receiver offline and the same per-client call counts.",
    "baseline_p99_ms": "Nearest-rank p99 latency in milliseconds for that foreground control.",
    "baseline_ms": "Total elapsed milliseconds for the matched foreground-only control.",
    "receiver_alloc_before": "Allocated filesystem bytes attributed to unique inodes under the receiver before starting it.",
    "receiver_alloc_peak": "Highest sampled receiver allocation in bytes, including before and after; sampled every 100 ms.",
    "legacy_same_offer_file_bytes": "Physical old-mode unmatched bytes for this exact offer, computed by comparing all candidate immutable tables byte-for-byte and counting all missing files and private metadata.",
    "legacy_same_offer_payload_bytes": "Old file-transfer mode on precisely this offer: manifest bytes + unmatched file bytes + canonical history bytes. Computed for comparison.",
    "measured_payload_bytes": "Actual manifest, file and history payload bytes, plus encoded request and reply bytes for the optional new proof RPC. Excludes ordinary Raft traffic, framing, TLS, and generic reverse-read envelope bytes.",
    "replay_proof_bytes": "Encoded protobuf request and reply bytes for the additional replay-proof RPC, including its routing fields.",
    "reverse_rpc_message_bytes": "Encoded protobuf request and reply body bytes for all reverse snapshot reads, including original data and proof RPC. Excludes initial Raft offer and reply, gRPC framing and headers, TLS, and ordinary Raft traffic.",
    "replay_base_index": "Receiver's locally verified checkpoint used for replay, or null when files were transferred."
  },
